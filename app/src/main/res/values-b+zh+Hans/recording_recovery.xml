<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="recording_recovery_title">录音恢复…</string>
    <string name="recording_recovery_explanation">原始音频会一直保留，直到保存后的文档里确实包含它。加入录音后还需要保存文档；拿不准时可以先留着以后处理。</string>
    <string name="recording_recovery_empty">没有待恢复的录音。</string>
    <string name="recording_recovery_kept">原始录音已保留，可打开「录音恢复」选择处理方式。</string>
    <string name="recording_recovery_invalid">无法读取录音信息，已原样保留；没有对应文档的音频会单独列出。</string>
    <string name="recording_recovery_missing">原始音频缺失或为空，恢复资料已保留。</string>
    <string name="recording_recovery_target_changed">请先打开要加入这段音频的文档。打开的文档已经换过，请重新开始恢复。</string>
    <string name="recording_recovery_present">文档里已经有这段录音。在确认它已保存之前，原始音频会继续保留。</string>
    <string name="recording_recovery_applying">这段音频之前加入过文档，可能后来被撤销或删除了。确定需要时再恢复。</string>
    <string name="recording_recovery_unbound">无法确认原来的文档，可以把音频作为独立录音加入，不关联已有笔迹。</string>
    <string name="recording_recovery_mismatch">这些信息属于其他文档或录音，可以把音频作为独立录音加入。</string>
    <string name="recording_recovery_pending">可以恢复这段音频，并保留它和笔迹的原有关联。</string>
    <string name="recording_recovery_restore">恢复录音</string>
    <string name="recording_recovery_separate">作为独立录音加入</string>
    <string name="recording_recovery_keep">保留供以后处理</string>
</resources>
