<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="pen_shortcuts_title">手写笔按键映射</string>
    <string name="pen_shortcuts_help">先录入按键，再分配工具或操作。映射仅在文档编辑器内生效；书写中切换工具会等到抬笔后执行。</string>
    <string name="pen_shortcuts_empty">尚未录入按键。旧 Pro Pen 3 映射不再使用，请重新录入按键。</string>
    <string name="pen_record_add">录入按键</string>
    <string name="pen_record_help">请在 15 秒内将笔悬停在下方区域，按下一个按键并松开。没有反应时，请按住按键轻触区域，再松开。也可录入以键盘事件上报的笔按键。</string>
    <string name="pen_record_area">按键录入区域</string>
    <string name="pen_record_failed">录入结束，未获得完整的按下和松开信号。请重试；系统可能未将此按键传给应用。</string>
    <string name="pen_record_duplicate">此按键已录入，请修改已有映射。</string>
    <string name="pen_record_success">已录入按键。请设置名称、功能和交互方式，然后保存。</string>
    <string name="pen_shortcut_default">按键 %1$d</string>
    <string name="pen_shortcut_name">按键名称</string>
    <string name="pen_shortcut_delete">删除映射</string>
    <string name="pen_shortcuts_limit">最多可录入 32 个按键。请先删除已有映射。</string>
    <string name="pen_shortcuts_invalid">无法保存：映射中有重复或无效按键，或已超过数量上限。</string>
    <string name="pen_shortcut_near_screen">此映射需要笔靠近屏幕。若需远离屏幕使用遥控按键，请在远处重新录入。</string>
    <string name="pen_record_multiple">检测到多个按键，请一次只录入一个按键。</string>
</resources>
